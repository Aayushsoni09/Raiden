# User-specific catalog files — never commit these
catalog/*.yaml
# Only the example and schema are allowed (inline comments aren't
# supported by git, so these must stay on their own lines).
!catalog/example-project.yaml
!catalog/_schema.yaml

# JetBrains IDE project files
.idea/

# Local env and credentials
.env
.env.*
*.pem
*.key
credentials/

# Claude Code local config (has your MCP paths etc.)
.claude/settings.local.json

# Audit logs — your incident history, not for the repo
audit/

# Any local SQLite evidence stores
*.db
*.sqlite

# Python
__pycache__/
*.pyc
.venv/
.pytest_cache/
*.egg-info/